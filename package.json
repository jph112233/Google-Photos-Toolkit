{
  "name": "google-photos-toolkit",
  "nameFull": "Google Photos Toolkit - Cleanup",
  "version": "4.0.0-cleanup.1",
  "description": "Free Up Space wizard plus bulk organize tools for Google Photos",
  "userScript": {
    "namespace": "https://github.com/jph112233/Google-Photos-Cleanup",
    "match": [
      "*://photos.google.com/*"
    ],
    "icon": "media/brand/prospera-mark.png",
    "run-at": "body",
    "grant": [
      "GM_registerMenuCommand",
      "unsafeWindow"
    ],
    "noframes": ""
  },
  "main": "google_photos_toolkit.user.js",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "xob0t (original), Prospera (cleanup wizard)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jph112233/Google-Photos-Cleanup/issues"
  },
  "homepage": "https://github.com/jph112233/Google-Photos-Cleanup#readme",
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@rollup/pluginutils": "^5.4.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "rollup": "^4.62.4",
    "rollup-plugin-banner2": "^1.3.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "8.2.1",
    "vitest": "^4.1.11"
  }
}
